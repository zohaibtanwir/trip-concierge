# Trip Concierge — local environment template.
#
# Copy to .env (backend, mcp_server) or .env.local (web), then fill in real
# values. Never commit a populated .env — see CLAUDE.md "Never do" §2.
# Source of truth for which var is used where is CLAUDE.md's env table.

# --- LLM (backend, mcp_server) ---
ANTHROPIC_API_KEY=

# --- Storage / cache (backend, agents worker) ---
DATABASE_URL=postgresql://localhost:5432/trip_concierge
# Used by both the backend's arq client (POST /trips/{id}/plan enqueues
# here) and the agents arq worker (pulls jobs from here). Must match
# across both projects.
REDIS_URL=redis://localhost:6379

# --- Search tools (backend; Researcher agent) ---
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Observability / tracing (backend, mcp_server, agents) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region host: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
# LANGFUSE_BASE_URL is accepted as a fallback for backward compatibility.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Auth (web) ---
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Internal endpoints (web) ---
BACKEND_URL=http://localhost:8000

# --- Internal RPC auth (backend, web) ---
# Shared secret used by Auth.js's signIn callback (web) → backend's
# /internal/auth/mint-mcp-token route to mint the user's MCP JWT.
# Generate with: openssl rand -base64 32
# Different trust root from TC_MCP_TOKEN_SECRET — compromise of this
# secret lets an attacker reaching the backend network mint MCP tokens
# for arbitrary user_ids; rotation immediately closes the surface.
INTERNAL_AUTH_SECRET=

# --- MCP token signing (backend only) ---
# Generate with: openssl rand -hex 32
# Backend signs MCP JWTs with this; mcp_server reads the issued token from
# disk (~/.config/trip-concierge/token), never the signing secret. Compromise
# = boot every active MCP session via rotation (v1.0 has no per-token revoke).
TC_MCP_TOKEN_SECRET=

# --- Magic-link email (web + backend) ---
# Same Resend account + from-address used by BOTH:
#   - web/Auth.js for PWA sign-in (slice 4.1)
#   - backend services/resend_send.py for MCP-side challenge (slice 4.1b)
# Different subject + body content distinguishes which surface — see
# trip-concierge-yv9 for the post-v1.0a consolidation followup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=auth@tripconcierge.app

# --- MCP-side magic-link challenge (backend) ---
# Lifetime of an auth_challenges row in minutes. 10 is the spec-locked
# default (slice 4.1 design dialogue: RATE_LIMIT_POLL_PER_CODE "1/2sec"
# × 600s window = 300-poll cap). Override only if you have a specific
# reason — shorter risks user timeout, longer wastes Postgres rows.
CHALLENGE_TTL_MINUTES=10

# --- MCP server runtime config (per-user, set in Claude Desktop) ---
# The user's email for the MCP-side magic-link challenge flow. Set in
# Claude Desktop's MCP server config block, NOT in shell env. Without
# it, MCP tools surface a setup hint instead of running.
# Example claude_desktop_config.json:
#   "trip-concierge": {
#     "command": "tc-mcp-server",
#     "env": {
#       "TC_MCP_USER_EMAIL": "you@example.com"
#     }
#   }
TC_MCP_USER_EMAIL=
