# Next.js (committed: next-env.d.ts — Next regenerates but content is stable
# and committing makes `tsc --noEmit` work on a fresh clone without `next dev`)
.next/
out/
*.tsbuildinfo

# Node / pnpm
node_modules/

# Playwright artifacts — local-only (traces on failure, screenshots)
test-results/
playwright-report/

# Playwright auth storageState — per-machine fixture, regenerated by
# `pnpm mint:auth`. Contains a JWE cookie tied to this machine's
# NEXTAUTH_SECRET, so committing it would leak the secret.
playwright-auth.json
