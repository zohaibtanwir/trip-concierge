{
  "name": "trip-concierge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mint:auth": "tsx scripts/mint-playwright-auth.ts",
    "seed:e2e-trip": "tsx scripts/seed-e2e-trip.ts",
    "test:e2e:unauthed": "playwright test --project=chromium",
    "test:e2e:auth": "pnpm seed:e2e-trip && pnpm mint:auth && playwright test --project=chromium-authed"
  },
  "dependencies": {
    "@auth/pg-adapter": "1.11.3",
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "maplibre-gl": "5.24.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "8.1.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@panva/hkdf": "1.2.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.5",
    "@types/pg": "8.20.0",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "jose": "6.2.5",
    "jsdom": "29.1.1",
    "playwright": "1.62.0",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
