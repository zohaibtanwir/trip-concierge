{
  "name": "trip-concierge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mint:auth": "tsx scripts/mint-playwright-auth.ts",
    "seed:e2e-trip": "tsx scripts/seed-e2e-trip.ts",
    "test:e2e:unauthed": "playwright test --project=chromium",
    "test:e2e:auth": "pnpm seed:e2e-trip && pnpm mint:auth && playwright test --project=chromium-authed"
  },
  "dependencies": {
    "@auth/pg-adapter": "1.11.2",
    "@base-ui/react": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "maplibre-gl": "5.24.0",
    "next": "15.5.19",
    "next-auth": "5.0.0-beta.31",
    "pg": "8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "8.1.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@panva/hkdf": "1.2.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.3",
    "@types/pg": "8.20.0",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.2",
    "jose": "6.2.3",
    "jsdom": "29.1.1",
    "playwright": "1.60.0",
    "shadcn": "4.11.0",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
